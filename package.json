{
  "name": "driveshare-app",
  "version": "0.0.9",
  "description": "DriveShare - App de escritorio",
  "main": "main.js",
  "scripts": {
    "start:prod": "electron .",
    "start:local": "set BACKEND_URL=http://localhost:3000&& electron .",
    "test:albaran-numbers": "node --test test/albaranNumbers.test.js",
    "test:document-order": "node --test test/documentOrder.test.js",
    "test:document-quality": "node --test test/documentQuality.test.js",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.driveshare.app",
    "productName": "DriveShare_Desarrollado",
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "JacoboBN",
        "repo": "Desarrollada_BGO_Frontend",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "axios": "^1.6.2",
    "electron-log": "^5.4.3",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.7.3",
    "form-data": "^4.0.6"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  }
}
