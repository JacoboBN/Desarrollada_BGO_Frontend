# DriveShare Electron frontend environment reference.
#
# Electron currently reads process.env directly and does NOT load this file.
# Copying this file to .env only records local values; it will not configure
# Electron unless a dotenv loader is intentionally added in the future.
#
# For local development use: npm run start:local
# For a custom value in PowerShell use:
#   $env:BACKEND_URL = 'http://localhost:3000'; npm run start:prod

# Backend base URL. Omit it to use the production default configured in main.js.
BACKEND_URL=http://localhost:3000

# Optional runtime flags. Values accepted by Boolean flags include true/false.
# NODE_ENV=development
# ENABLE_REFRESH_TOKENS=false
# RESET_SESSION_ON_START=false
# ENABLE_STARTUP_NO_PROCESADO_SCAN=false

# Optional upload tuning. These shown values match the application defaults.
# DRIVE_UPLOAD_TIMEOUT_MS=180000
# DRIVE_UPLOAD_CONCURRENCY=3